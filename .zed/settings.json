{
  "lsp": {
    "nixd": {
      "settings": {
        "formatting": { "command": ["nixfmt"] },
        "nixpkgs": {
          "expr": "import <nixpkgs> { }",
        },
        "options": {
          "nixos": {
            "expr": "(builtins.getFlake \"/home/rikiub/.config/nixos\").nixosConfigurations.acer-laptop.options",
          },
          "home-manager": {
            "expr": "(builtins.getFlake \"/home/rikiub/.config/nixos\").homeConfigurations.\"rikiub@acer-laptop\".options",
          },
          "flake-parts": {
            "expr": "(builtins.getFlake \"/home/rikiub/.config/nixos\").debug.options",
          },
        },
      },
    },
  },
}
