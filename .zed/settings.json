{
  "lsp": {
    "nixd": {
      "settings": {
        "nixpkgs": {
          "expr": "import <nixpkgs> { }",
        },
        "formatting": {
          "command": ["nixfmt"],
        },
        "options": {
          "nixos": {
            "expr": "(builtins.getFlake \"/etc/nixos\").nixosConfigurations.nixos.options",
          },
          "home-manager": {
            "expr": "(builtins.getFlake \"/etc/nixos\").nixosConfigurations.nixos.options.home-manager.users.type.getSubOptions []",
          },
        },
      },
    },
  },
}
